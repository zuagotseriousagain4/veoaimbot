-- Skin row: weapon name (left), current skin cycle button (right), [N/M] index
local function SkinRow(parent, weaponName)
    local folder = SkinsFolder:FindFirstChild(weaponName)
    if not folder then return end
    local options = {}
    for _, c in ipairs(folder:GetChildren()) do table.insert(options, c.Name) end
    if #options == 0 then return end
    SkinOptions[weaponName] = options
    if not SelectedSkins[weaponName] then SelectedSkins[weaponName] = options[1] end
    SkinIndex[weaponName] = 1
    for i,o in ipairs(options) do if o == SelectedSkins[weaponName] then SkinIndex[weaponName] = i end end

    local f = row(parent,30)
    mk("TextLabel",{Size=UDim2.new(0,140,1,0), Position=UDim2.new(0,12,0,0), BackgroundTransparency=1, Text=weaponName, Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=Color3.fromRGB(220,220,230), TextXAlignment=Enum.TextXAlignment.Left}, f)
    local btn = mk("TextButton",{Size=UDim2.new(1,-160,0,20), Position=UDim2.new(0,152,0.5,-10), BackgroundColor3=Color3.fromRGB(30,30,38), BorderSizePixel=0, Text="", Font=Enum.Font.Gotham, TextSize=11, TextColor3=Color3.fromRGB(220,220,230), TextTruncate=Enum.TextTruncate.AtEnd}, f); corner(btn,4)
    local function refresh()
        local i = SkinIndex[weaponName]
        btn.Text = string.format("%s  (%d/%d)", SelectedSkins[weaponName], i, #options)
    end
    refresh()
    SkinCallbacks[weaponName] = SkinCallbacks[weaponName] or {}
    table.insert(SkinCallbacks[weaponName], refresh)
    btn.MouseButton1Click:Connect(function()
        local i = (SkinIndex[weaponName] % #options) + 1
        SkinIndex[weaponName] = i
        SelectedSkins[weaponName] = options[i]
        for _, cb in ipairs(SkinCallbacks[weaponName]) do cb() end
        for _, obj in ipairs(Camera:GetChildren()) do
            obj:SetAttribute("SkinApplied", nil); applyWeaponSkin(obj)
        end
    end)
end

