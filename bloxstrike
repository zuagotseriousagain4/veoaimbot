-- 4. HITBOX EXTENDER
------------------------------------------------------------------
local origState = setmetatable({}, {__mode = "k"})
local function snapshot(part)
    if origState[part] then return end
    origState[part] = {Size=part.Size, Transparency=part.Transparency, CanCollide=part.CanCollide,
                       Massless=part.Massless, Color=part.Color, Material=part.Material}
end
local function inflate(part)
    snapshot(part)
    part.Size       = Vector3.new(CFG.HitboxSize, CFG.HitboxSize, CFG.HitboxSize)
    part.CanCollide = false
    part.Massless   = true
    if CFG.HitboxVisual then
        part.Transparency = 0.5; part.Color = CFG.HitboxColor; part.Material = Enum.Material.ForceField
    else
        part.Transparency = 1
    end
end
local function restore(part)
    local s = origState[part]
    if not s or not part.Parent then return end
    pcall(function()
        part.Size, part.Transparency, part.CanCollide = s.Size, s.Transparency, s.CanCollide
        part.Massless, part.Color, part.Material      = s.Massless, s.Color, s.Material
    end)
    origState[part] = nil
end
local function restoreAll() for p,_ in pairs(origState) do restore(p) end end

task.spawn(function()
    while true do
        task.wait(CFG.HitboxRefresh)
        local folder = getEnemyFolder()
        if folder then
            for _, enemy in ipairs(folder:GetChildren()) do
                if aliveModel(enemy) then
                    local part = enemy:FindFirstChild(CFG.HitboxPart)
                        or enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
                    if part then
                        if CFG.HitboxEnabled then inflate(part) else restore(part) end
                    end
                end
            end
        end
        if not CFG.HitboxEnabled then
            for p,_ in pairs(origState) do
                if not p.Parent or not aliveModel(p.Parent) then restore(p) end
            end
        end
    end
end)

