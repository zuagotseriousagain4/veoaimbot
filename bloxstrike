local SelectedSkins = {}
local SkinOptions   = {}
local SkinIndex     = {}    -- weapon -> current index in SkinOptions[weapon]
local SkinCallbacks = {}    -- weapon -> ui refresh callbacks
local SKIN_COOLDOWN = 0.1
local WEAR = "Factory New"

local CT_ONLY = {["USP-S"]=true,["Five-SeveN"]=true,["MP9"]=true,["FAMAS"]=true,["M4A1-S"]=true,["M4A4"]=true,["AUG"]=true}
local SHARED  = {["P250"]=true,["Desert Eagle"]=true,["Dual Berettas"]=true,["Negev"]=true,["P90"]=true,["Nova"]=true,["XM1014"]=true,["AWP"]=true,["SSG 08"]=true}
local KNIVES  = {["Karambit"]=true,["Butterfly Knife"]=true,["M9 Bayonet"]=true,["Flip Knife"]=true,["Gut Knife"]=true,["T Knife"]=true,["CT Knife"]=true}
local GLOVES  = {["Sports Gloves"]=true}
local IGNORE  = {["HE Grenade"]=true,["Incendiary Grenade"]=true,["Molotov"]=true,["Smoke Grenade"]=true,["Flashbang"]=true,["Decoy Grenade"]=true,["C4"]=true,["CT Glove"]=true,["T Glove"]=true}

local SkinsFolder = RS:WaitForChild("Assets"):WaitForChild("Skins")

local function applyWeaponSkin(model)
    if not model or not CFG.SkinChangerEnabled or not isAlive() then return end
    local skinName = SelectedSkins[model.Name]
    if not skinName then return end
    pcall(function()
        local skinFolder = SkinsFolder:FindFirstChild(model.Name); if not skinFolder then return end
        local skinType = skinFolder:FindFirstChild(skinName)
        local src = skinType and skinType:FindFirstChild("Camera") and skinType.Camera:FindFirstChild(WEAR)
        if not src then return end

        for _, obj in ipairs(Camera:GetChildren()) do
            local left, right = obj:FindFirstChild("Left Arm"), obj:FindFirstChild("Right Arm")
            if left or right then
                local gf = SkinsFolder:FindFirstChild("Sports Gloves")
                local gs = gf and gf:FindFirstChild(SelectedSkins["Sports Gloves"] or "")
                local gsrc = gs and gs:FindFirstChild("Camera") and gs.Camera:FindFirstChild(WEAR)
                if gsrc then
                    for _, side in ipairs({"Left Arm","Right Arm"}) do
                        local arm, srcArm = obj:FindFirstChild(side), gsrc:FindFirstChild(side)
                        if arm and srcArm then
                            local glove = arm:FindFirstChild("Glove")
                            if glove then
                                local ex = glove:FindFirstChildOfClass("SurfaceAppearance")
                                if ex then ex:Destroy() end
                                local c = srcArm:Clone(); c.Name = "SurfaceAppearance"; c.Parent = glove
                            end
                        end
                    end
                end
            end
        end

        if not GLOVES[model.Name] then
            local wf = model:FindFirstChild("Weapon")
            if wf then
                for _, part in ipairs(wf:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local ns = src:FindFirstChild(part.Name)
                        if ns then
                            local ex = part:FindFirstChildOfClass("SurfaceAppearance")
                            if ex then ex:Destroy() end
                            local c = ns:Clone(); c.Name = "SurfaceAppearance"; c.Parent = part
                        end
                    end
                end
            end
        end
        model:SetAttribute("SkinApplied", skinName)
    end)
end

Camera.ChildAdded:Connect(function(obj)
    if not CFG.SkinChangerEnabled or not isAlive() then return end
    task.wait(SKIN_COOLDOWN); applyWeaponSkin(obj)
end)
task.spawn(function()
    while task.wait(0.5) do
        if CFG.SkinChangerEnabled and isAlive() then
            for _, obj in ipairs(Camera:GetChildren()) do
                if SelectedSkins[obj.Name] and obj:GetAttribute("SkinApplied") ~= SelectedSkins[obj.Name] then
                    applyWeaponSkin(obj)
                end
            end
        end
    end
end)

