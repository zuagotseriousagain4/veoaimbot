local KnifeOffsets = {
    ["Karambit"]        = CFrame.new(0, -1.5, 1.5),
    ["Butterfly Knife"] = CFrame.new(0, -1.5, 1.5),
    ["M9 Bayonet"]      = CFrame.new(0, -1.5, 1),
