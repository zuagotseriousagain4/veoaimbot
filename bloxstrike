}
local ACTION_INSPECT = "ENI_InspectKnife"
local ACTION_ATTACK  = "ENI_AttackKnife"
local ATTACK_COOLDOWN = 1
pcall(function() RS.Assets.Weapons.Karambit.Camera.ViewmodelLight.Transparency = 1 end)

local vm, animator
local equipAnim, idleAnim, inspectAnim, HeavySwingAnim, Swing1Anim, Swing2Anim
local spawned, inspecting, swinging = false, false, false
local lastAttackTime = 0

local function getKnifeInCamera()
    return Camera:FindFirstChild("T Knife") or Camera:FindFirstChild("CT Knife")
end
local function cleanPart(part)
    if not part:IsA("BasePart") then return end
    part.CanCollide, part.Anchored, part.CastShadow, part.CanTouch, part.CanQuery = false, false, false, false, false
end
local function disableCollisions(model) for _, p in ipairs(model:GetDescendants()) do cleanPart(p) end end
local function hideOriginalKnife(knife)
    for _, part in ipairs(knife:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("Texture") then part.Transparency = 1 end
    end
end
local function playKnifeSound(folder, name)
    local ws = RS.Sounds:FindFirstChild(CFG.SelectedKnife)
    if not ws then return end
    local s = ws:WaitForChild(folder):WaitForChild(name):Clone()
    s.Parent = Camera; s:Play()
    s.Ended:Once(function() s:Destroy() end)
    return s
end
local function attachAsset(folder, armPartName, assetModelName, finalName, offset)
    local arm = vm:FindFirstChild(armPartName); if not arm then return end
    local mesh = folder:WaitForChild(assetModelName):Clone()
    cleanPart(mesh); mesh.Name = finalName; mesh.Parent = arm
    local m = Instance.new("Motor6D")
    m.Part0, m.Part1, m.C0, m.Parent = arm, mesh, offset, arm
end

local function handleKnifeAction(actionName, inputState)
    if inputState ~= Enum.UserInputState.Begin or not spawned or not animator or not isAlive() then
        return Enum.ContextActionResult.Pass
    end
    if actionName == ACTION_INSPECT then
        if (equipAnim and equipAnim.IsPlaying) or inspecting or swinging then
            return Enum.ContextActionResult.Pass
        end
        inspecting = true
        if idleAnim then idleAnim:Stop() end
        inspectAnim:Play()
        inspectAnim.Stopped:Once(function() inspecting = false end)
    elseif actionName == ACTION_ATTACK then
        local now = os.clock()
        if (equipAnim and equipAnim.IsPlaying) or (now - lastAttackTime < ATTACK_COOLDOWN) then
            return Enum.ContextActionResult.Pass
        end
        lastAttackTime = now
        if inspecting then inspecting = false; if inspectAnim then inspectAnim:Stop() end end
        swinging = true
        if idleAnim then idleAnim:Stop() end
        local anims = {HeavySwingAnim, Swing1Anim, Swing2Anim}
        local chosen = anims[math.random(1, #anims)]
        local sndFolder = (chosen == HeavySwingAnim and "HitOne")
            or (chosen == Swing1Anim and "HitTwo") or "HitThree"
        chosen:Play()
        local s = playKnifeSound(sndFolder, "1"); if s then s.Volume = 5 end
        chosen.Stopped:Once(function() swinging = false end)
    end
    return Enum.ContextActionResult.Pass
end

local function removeViewmodel()
    spawned = false
    pcall(function() CAS:UnbindAction(ACTION_INSPECT) end)
    pcall(function() CAS:UnbindAction(ACTION_ATTACK) end)
    if vm then vm:Destroy(); vm = nil end
    animator, inspecting, swinging = nil, false, false
end

local function spawnViewmodel(knife)
    if spawned or not CFG.KnifeEnabled then return end
    local me = isAlive(); if not me then return end
    spawned = true
    local ok, err = pcall(function()
        local tmpl = RS.Assets.Weapons:WaitForChild(CFG.SelectedKnife)
        local off  = KnifeOffsets[CFG.SelectedKnife] or CFrame.new(0, -1.5, 1)
        vm = tmpl:WaitForChild("Camera"):Clone()
        vm.Name, vm.Parent = CFG.SelectedKnife, Camera
        disableCollisions(vm)
        hideOriginalKnife(knife)
        if me.Parent.Name == "Terrorists" then
            local g = RS.Assets.Weapons:WaitForChild("T Glove")
            attachAsset(g, "Left Arm",  "Left Arm",  "Glove", CFrame.new(0,0,-1.5))
            attachAsset(g, "Right Arm", "Right Arm", "Glove", CFrame.new(0,0,-1.5))
        else
            local sl = RS.Assets.Sleeves:WaitForChild("IDF")
            local g  = RS.Assets.Weapons:WaitForChild("CT Glove")
            attachAsset(sl, "Left Arm",  "Left Arm",  "Sleeve", CFrame.new(0,0, 0.5))
            attachAsset(g,  "Left Arm",  "Left Arm",  "Glove",  CFrame.new(0,0,-1.5))
            attachAsset(sl, "Right Arm", "Right Arm", "Sleeve", CFrame.new(0,0, 0.5))
            attachAsset(g,  "Right Arm", "Right Arm", "Glove",  CFrame.new(0,0,-1.5))
        end
        local ac = vm:FindFirstChildOfClass("AnimationController") or vm:FindFirstChildOfClass("Animator")
        animator = ac:FindFirstChildWhichIsA("Animator") or ac
        local af = RS.Assets.WeaponAnimations:WaitForChild(CFG.SelectedKnife):WaitForChild("CameraAnimations")
        equipAnim      = animator:LoadAnimation(af:WaitForChild("Equip"))
        idleAnim       = animator:LoadAnimation(af:WaitForChild("Idle"))
        inspectAnim    = animator:LoadAnimation(af:WaitForChild("Inspect"))
        HeavySwingAnim = animator:LoadAnimation(af:WaitForChild("Heavy Swing"))
        Swing1Anim     = animator:LoadAnimation(af:WaitForChild("Swing1"))
        Swing2Anim     = animator:LoadAnimation(af:WaitForChild("Swing2"))
        vm:SetPrimaryPartCFrame(Camera.CFrame * CFrame.new(0, -1.5, 5))
        TweenService:Create(vm.PrimaryPart, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            CFrame = Camera.CFrame * off
        }):Play()
        equipAnim:Play()
        playKnifeSound("Equip", "1")
        CAS:BindAction(ACTION_INSPECT, handleKnifeAction, false, Enum.KeyCode.F)
        CAS:BindAction(ACTION_ATTACK,  handleKnifeAction, false, Enum.UserInputType.MouseButton1)
    end)
    if not ok then spawned = false; warn("[ENI] knife spawn failed: " .. tostring(err)) end
end

RunService.RenderStepped:Connect(function()
    if not CFG.KnifeEnabled or not vm or not vm.PrimaryPart then return end
    local off = KnifeOffsets[CFG.SelectedKnife] or CFrame.new(0,-1.5,1)
    vm.PrimaryPart.CFrame = Camera.CFrame * off
    if not (equipAnim and equipAnim.IsPlaying) and not inspecting and not swinging then
        if idleAnim and not idleAnim.IsPlaying then idleAnim:Play() end
    end
end)

task.spawn(function()
