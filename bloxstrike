local function hideSet(s) for _, d in pairs(s) do d.Visible = false end end

RunService.RenderStepped:Connect(function()
    local enemyFolder = getEnemyFolder()
    local cur = {}
    local function addModels(folder)
        if not folder then return end
        for _, m in ipairs(folder:GetChildren()) do
            if m ~= LP.Character then
                cur[m] = true
                if not ESP[m] then buildESP(m) end
            end
        end
    end
    if CFG.ESPTeamCheck then
        addModels(enemyFolder)
    else
        addModels(getTFolder())
        addModels(getCTFolder())
    end
    for m,_ in pairs(ESP) do if not cur[m] then destroyESP(m) end end
    if not CFG.ESPEnabled then for _,s in pairs(ESP) do hideSet(s) end; return end
    local vps = Camera.ViewportSize
    for model, s in pairs(ESP) do
        local ok = false
        if aliveModel(model) then
            local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
            local head = model:FindFirstChild("Head") or root
            local hum  = model:FindFirstChildOfClass("Humanoid")
            if root and head then
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                if dist <= CFG.ESPMaxDist then
                    local screen, on = Camera:WorldToViewportPoint(root.Position + Vector3.new(0,0.5,0))
                    local headScr    = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    local footScr    = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
                    if on then
                        ok = true
                        local h = math.abs(headScr.Y - footScr.Y)
                        local w = h * 0.55
                        local x = screen.X - w/2; local y = headScr.Y
                        local col = (model.Parent == enemyFolder) and CFG.ColEnemy or Color3.fromRGB(100, 200, 255)
                        s.Box.Visible = CFG.ESPBox; s.BoxOut.Visible = CFG.ESPBox
                        s.Box.Position = Vector2.new(x,y); s.Box.Size = Vector2.new(w,h); s.Box.Color = col
                        s.BoxOut.Position = Vector2.new(x-1,y-1); s.BoxOut.Size = Vector2.new(w+2,h+2)
                        s.Name.Visible = CFG.ESPName
                        s.Name.Text = model.Name
                        s.Name.Position = Vector2.new(screen.X, y - 16)
                        s.Dist.Visible = CFG.ESPDistance
                        s.Dist.Text = ("[%dm]"):format(dist)
                        s.Dist.Position = Vector2.new(screen.X, y + h + 2)
                        local pct = hum and (hum.Health / math.max(hum.MaxHealth,1)) or 0
                        s.HpBack.Visible = CFG.ESPHealth; s.Hp.Visible = CFG.ESPHealth
                        s.HpBack.Position = Vector2.new(x-6,y); s.HpBack.Size = Vector2.new(3,h)
                        s.Hp.Position = Vector2.new(x-6, y + h*(1-pct)); s.Hp.Size = Vector2.new(3, h*pct)
                        s.Hp.Color = Color3.fromRGB(255 - pct*175, 80 + pct*175, 100)
                        s.Dot.Visible = CFG.ESPHeadDot
                        s.Dot.Position = Vector2.new(headScr.X, headScr.Y); s.Dot.Color = col
                        s.Tracer.Visible = CFG.ESPTracer
                        s.Tracer.From = Vector2.new(vps.X/2, vps.Y)
                        s.Tracer.To = Vector2.new(screen.X, y + h); s.Tracer.Color = col
                    end
                end
            end
        end
        if not ok then hideSet(s) end
    end
end)

